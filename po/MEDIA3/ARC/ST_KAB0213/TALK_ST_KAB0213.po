msgctxt "ES0326562"
msgid "Podrías ser el hombre más fuerte||del mundo, {PA:10}con el entrenamiento adecuado."
msgstr ""

#. type: dialogue
#. speaker: Sotaro Komaki
#. speaker-source: meta_0209_explicit
#. line-id: 65_0_6
#. en-match: 1:1 (EN:ES)
#. en-confidence: high
#. english: However,{PA:10} talking to a Yakuza is like||{MS:0}talking to a brick wall. [line-id 65_0_6]
#. jp-match: 1:1 (JP:ES via EN)
#. jp-confidence: high
#. jp-via-english: 1/1
#. japanese: しかし、{PA:10}極道者にこのようなことを言っても||{MS:0}分からんじゃろう。 [line-id 84_0_6]
msgctxt "ES0326563"
msgid "De todas formas,{PA:10} hablar con un Yakuza es||{MS:0}como hablarle a un muro de piedra."
msgstr ""

