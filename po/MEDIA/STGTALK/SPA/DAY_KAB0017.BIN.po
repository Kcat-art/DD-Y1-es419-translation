#. y1:english_source=MEDIA/STGTALK/BRI/DAY_KAB0017.BIN
#. y1:english_ids=["78_1_0"]
#. y1:english="Sorry. I have to go to the bar.||Maybe next time."
#: MEDIA/STGTALK/SPA/DAY_KAB0017.BIN:78_1_0
msgctxt "MEDIA/STGTALK/SPA/DAY_KAB0017.BIN::line:78_1_0"
msgid "Lo siento. Tengo que ir al bar.||Tal vez la próxima..."
msgstr ""

