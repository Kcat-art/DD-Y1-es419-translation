#: MEDIA/STGTALK/SPA/DAY_KAB0032.BIN:111_1_8
msgctxt "MEDIA/STGTALK/SPA/DAY_KAB0032.BIN::line:111_1_8"
msgid "Sabes,{PA:10} ganarás 10.000 yenes en nada||de tiempo cuando empieces a trabajar."
msgstr ""

