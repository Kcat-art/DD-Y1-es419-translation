#: MEDIA/STGTALK/SPA/DAY_KAB0001.BIN:125_0_0
msgctxt "MEDIA/STGTALK/SPA/DAY_KAB0001.BIN::line:125_0_0"
msgid "iOye tú! ¿Sabes si hay un hospital||o una clínica por aquí?"
msgstr ""

