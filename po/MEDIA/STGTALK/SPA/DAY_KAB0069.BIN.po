#: MEDIA/STGTALK/SPA/DAY_KAB0069.BIN:78_2_26
msgctxt "MEDIA/STGTALK/SPA/DAY_KAB0069.BIN::line:78_2_26"
msgid "Un \"arma\" puede incluso ser algo{PA:10}||que cojas del suelo."
msgstr ""

