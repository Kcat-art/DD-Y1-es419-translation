#: MEDIA/STGTALK/SPA/ST_KAB0044.BIN:107_1_1
msgctxt "MEDIA/STGTALK/SPA/ST_KAB0044.BIN::line:107_1_1"
msgid "Será un honor que seas tú quien me mate.{PA:20}||Mátame,{PA:10} por favor..."
