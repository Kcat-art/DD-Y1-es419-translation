#: MEDIA/STGTALK/SPA/ST_KAB0213.BIN:66_3_2
msgctxt "MEDIA/STGTALK/SPA/ST_KAB0213.BIN::line:66_3_2"
msgid "Presencié tu espléndida||victoria en el Coliseo."
msgstr ""

