#: MEDIA/STGTALK/SPA/RAIN_KAB0200.BIN:42_1_13
msgctxt "MEDIA/STGTALK/SPA/RAIN_KAB0200.BIN::line:42_1_13"
msgid "Has obtenido 500 puntos de exp."
msgstr ""

