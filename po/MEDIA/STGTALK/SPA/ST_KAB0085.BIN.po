#: MEDIA/STGTALK/SPA/ST_KAB0085.BIN:36_0_8
msgctxt "MEDIA/STGTALK/SPA/ST_KAB0085.BIN::line:36_0_8"
msgid "Ok,{PA:10} golpea 10 o más home runs."
msgstr ""

