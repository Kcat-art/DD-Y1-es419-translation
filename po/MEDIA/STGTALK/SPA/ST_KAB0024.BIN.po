#: MEDIA/STGTALK/SPA/ST_KAB0024.BIN:76_0_9
msgctxt "MEDIA/STGTALK/SPA/ST_KAB0024.BIN::line:76_0_9"
msgid "Pareces duro,{PA:10} tal vez los asustes."
msgstr ""

