#: MEDIA/STGTALK/SPA/RAIN_KAB0003.BIN:9_3_11
msgctxt "MEDIA/STGTALK/SPA/RAIN_KAB0003.BIN::line:9_3_11"
msgid "Es un buen negocio.{PA:20}||Ok... Vamos a ello."
msgstr ""

