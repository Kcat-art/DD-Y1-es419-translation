#: MEDIA/STGTALK/SPA/DAY_KAB0014.BIN:9_2_0
msgctxt "MEDIA/STGTALK/SPA/DAY_KAB0014.BIN::line:9_2_0"
msgid "Hola, Kazuma-san. Estoy en la sala de||monitores ahora mismo y me han llegado"
