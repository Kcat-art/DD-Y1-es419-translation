#: MEDIA/STGTALK/SPA/ST_KAB0002.BIN:101_1_1
msgctxt "MEDIA/STGTALK/SPA/ST_KAB0002.BIN::line:101_1_1"
msgid "Será un honor que seas tú quien me mate.{PA:20}||Mátame,{PA:10} por favor..."
