#: MEDIA/STGTALK/SPA/ST_KAB0071.BIN:87_1_12
msgctxt "MEDIA/STGTALK/SPA/ST_KAB0071.BIN::line:87_1_12"
msgid "Pero elige a tus oponentes mejor||o acabarás haciéndote daño."
msgstr ""

