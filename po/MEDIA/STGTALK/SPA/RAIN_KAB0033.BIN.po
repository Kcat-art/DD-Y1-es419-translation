#: MEDIA/STGTALK/SPA/RAIN_KAB0033.BIN:84_1_12
msgctxt "MEDIA/STGTALK/SPA/RAIN_KAB0033.BIN::line:84_1_12"
msgid "Pero elige a tus oponentes mejor||o acabarás haciéndote daño."
msgstr ""

