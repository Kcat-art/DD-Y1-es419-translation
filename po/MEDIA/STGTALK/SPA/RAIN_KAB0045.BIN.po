#: MEDIA/STGTALK/SPA/RAIN_KAB0045.BIN:85_1_1
msgctxt "MEDIA/STGTALK/SPA/RAIN_KAB0045.BIN::line:85_1_1"
msgid "Será un honor que seas tú quien me mate.{PA:20}||Mátame,{PA:10} por favor..."
