msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_2_0"
msgid "Un ramo de rosas de color rojo brillante.||A las mujeres les encantan."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="A bunch of pink lilies.||A pleasing gift for women."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_3_0"
msgid "Azucenas rosadas.||Un buen regalo para las mujeres."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="An assortment of cookies.||The classic gift."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_4_0"
msgid "Un surtido de galletas.||El regalo por antonomasia."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="A caviar skin bag.||The perfect gift for women."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_5_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_5_0"
msgid "Bolsa de cuero 'Caviar'.||El regalo perfecto para las mujeres."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_6_0"]
#. y1:english="The monogram bag.||Without a doubt, a pleasing gift."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_6_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_6_0"
msgid "Un bolso de marca.||Sin duda alguna es un buen regalo."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="An expensive brand necklace.||A good gift for women."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_7_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_7_0"
msgid "Un collar de marca cara.||Un buen regalo para una mujer."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_8_0"]
#. y1:english="An Italian-made ladies' watch. A luxury||item that will make a pleasing gift."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_8_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_8_0"
msgid "Reloj de mujer fabricado en Italia.||Este objeto de lujo es un buen regalo."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_9_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_9_0"]
#. y1:english="A French-made scarf.||Excellent as a gift."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_9_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_9_0"
msgid "Una bufanda francesa.||Un regalo excelente."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_10_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_10_0"]
#. y1:english="Apparently called Lucky Bracelet.||It's supposed to give you luck with women..."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_10_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_10_0"
msgid "Parece que lo llaman Brazalete Fortuna.||Se supone que te da suerte con las mujeres."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_11_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_11_0"]
#. y1:english="Chain mail armor. It will fit you. I guess||people don't really wear things like this lately."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_11_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_11_0"
msgid "Armadura de cota de malla. Te quedará bien,||aunque la gente no lleva este tipo de cosas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_12_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_12_0"]
#. y1:english="A western shield. It'd look nice on your||wall, that is if you have a big house."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_12_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_12_0"
msgid "Un escudo occidental. Es para decoración,||pero haría falta tener una casa muy grande."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_13_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_13_0"]
#. y1:english="Goddess' Charm. It's pretty old.||It's supposed to protect you in fights."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_13_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_13_0"
msgid "Amuleto de la diosa de los niños. Es antiguo||se supone que te protegerá en batallas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_14_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_14_0"]
#. y1:english="Pimp Bracelet. The name says it all,||but I don't know if it really works."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_14_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_14_0"
msgid "Brazalete de imán de chicas. Es lo que su||nombre indica. No sé si realmente funciona."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_15_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_15_0"]
#. y1:english="Macho cologne. Apparently it was produced by||extracting male pheromones."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_15_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_15_0"
msgid "Colonia 7 Machos. Parece que para producirla||extrajeron feromonas masculinas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_16_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_16_0"]
#. y1:english="A long dagger. Some Yakuza said he was going||to go legit and sold it for next to nothing."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_16_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_16_0"
msgid "Daga larga. Un Yakuza dijo que iba abandonar||la delincuencia y la vendió por casi nada."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_17_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_17_0"]
#. y1:english="The Lau family's Chinese sword. It looks old||but it has a sharp edge."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_17_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_17_0"
msgid "Espada china de la familia Lau. Parece||antigua, pero la hoja está afilada."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_18_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_18_0"]
#. y1:english="A Kodachi that Musashi used. Well, it just||means that an expert swordsman is with you."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_18_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_18_0"
msgid "Kodachi que utilizó Musashi. Bueno, eso sólo||significa que tienes a un espadachín experto."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_19_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_19_0"]
#. y1:english="Mifune's Kodachi. It's used in festivities,||but it's a practical short sword, as well."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_19_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_19_0"
msgid "Kodachi de Mifune. Se usa para celebraciones||pero también es una espada corta práctica."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_20_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_20_0"]
#. y1:english="Although it has no name, it gleams brightly||and has a good blade."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_20_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_20_0"
msgid "Aunque es una espada japonesa sin grabados,||tiene un fuerte brillo y una buena hoja."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_21_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_21_0"]
#. y1:english="The Bungo Shimizu Sword? A great thing.||It's got a great edge, but a little weak."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_21_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_21_0"
msgid "¿La Espada Shimizu? Es magnífica.||El borde es bueno, pero no muy resistente."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:type=line
#. y1:id=2_22_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0006.BIN
#. y1:english_ids=["2_22_0"]
#. y1:english="A sword engraved with the Tesshusai signature.||This is a good sword. It's the best item here."
#: MEDIA/TALK/SHOP/TALK_SHOP0006.BIN:2_22_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0006.BIN::line:2_22_0"
msgid "Una espada grabada con la marca Tesshusai.||Es una buena espada. La mejor que tengo."
msgstr ""
