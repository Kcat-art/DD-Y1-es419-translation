#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="The farm that we have a contract with gives||us quality beans that we carefully roast."
#: MEDIA/TALK/SHOP/TALK_SHOP0010.BIN:2_1_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_1_0"
msgid "Tenemos un contrato exclusivo con una granja||que nos brinda granos de la mejor calidad."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:type=line
#. y1:id=2_2_0
