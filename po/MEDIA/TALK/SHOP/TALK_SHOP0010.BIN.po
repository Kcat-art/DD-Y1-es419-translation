#. y1:english_ids=["2_0_0"]
#. y1:english="Proudly presenting our original blend of||coffee. Please enjoy its rich aroma."
#: MEDIA/TALK/SHOP/TALK_SHOP0010.BIN:2_0_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_0_0"
msgid "Presentamos nuestra original mezcla de café.||Por favor, disfrute de su rico aroma."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:type=line
#. y1:id=2_1_0
