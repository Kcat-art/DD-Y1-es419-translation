#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="Fresh apples delivered from Aomori are used||for this rich scented juice."
#: MEDIA/TALK/SHOP/TALK_SHOP0010.BIN:2_7_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_7_0"
msgid "Para obtener este aromático zumo,||se utilizan manzanas de Aomori."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
