msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_8_0"
msgid "Nuestro zumo de limón especial ha sido||carbonatado para obtener bebidas aromáticas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
