#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="Beans imported from Italy and cinnamon are||what make this aromatic coffee."
#: MEDIA/TALK/SHOP/TALK_SHOP0010.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_2_0"
msgid "Los granos de café importados de Italia y la||canela son la base de este aromático café."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="Our great espresso machine is responsible||for the rich body of this finest of coffees."
#: MEDIA/TALK/SHOP/TALK_SHOP0010.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_3_0"
msgid "Esta máquina de espresso que nos honra||hace un café con una textura magnífica."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="Traditional tea in accordance with||the British method of tea making."
#: MEDIA/TALK/SHOP/TALK_SHOP0010.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_4_0"
msgid "Té tradicional siguiendo la receta británica.||Indispensable para la hora del té."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="Organic lemon is used||in this refreshing aromatic tea."
#: MEDIA/TALK/SHOP/TALK_SHOP0010.BIN:2_5_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_5_0"
msgid "Para obtener este té tan aromático y||refrescante se utiliza limón orgánico."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:type=line
#. y1:id=2_6_0
