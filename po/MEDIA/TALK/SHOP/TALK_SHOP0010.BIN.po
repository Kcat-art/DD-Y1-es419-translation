msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0010.BIN::line:2_6_0"
msgid "Para obtener este zumo se utilizan||naranjas maduradas al sol."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0010.BIN
#. y1:type=line
#. y1:id=2_7_0
