#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_0_0"]
#. y1:english="Tonfa. American police use them too.||They do much more damage than bare hands."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_0_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_0_0"
msgid "Tonfa. La policía americana también los usa.||Hace más daño que las manos desnudas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="A tactical baton. It's a striking weapon.||Easy to handle since it folds up compactly."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_1_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_1_0"
msgid "Un bastón táctico. Es un arma contundente.||es fácil de manejar porque se puede plegar."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="A military survival knife.||It looks like it was really made for combat."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_2_0"
msgid "Una navaja militar del ejército.||Parece pensado para el combate."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="A blackjack. It deals damage without||leaving any bruises."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_3_0"
msgid "Una cachiporra, también conocida como||Blackjack. Puede golpear sin dejar marcas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="A stun gun. It renders the enemy powerless||with high voltage electricity."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_4_0"
msgid "Una pistola aturdidora. Deja al enemigo||impotente con electricidad de alto voltaje."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="Brass knuckles.||You can swing a good punch even with {IC:00_00}➿."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_5_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_5_0"
msgid "Nudillos metálicos. Tienes que acostumbrarte.||Puedes asestar un puñetazo con {IC:00_00}➿."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_6_0"]
#. y1:english="Mace. Self-defence gear that'll temporarily||blind whomever it's sprayed at."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_6_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_6_0"
msgid "Spray de defensa personal. Defensa propia,||cegando temporalmente a quien se aplique."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="A typical Chinese sword.||I reckon it's easier to use than a dagger."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_7_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_7_0"
msgid "Una típica espada china.||Creo que es más fácil de usar que una daga."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_8_0"]
#. y1:english="An electric bomb. Think of it as the bomb||version of a stun gun."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_8_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_8_0"
msgid "Una bomba eléctrica. Imagínatela como una||pistola aturdidora, pero en versión bomba."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_9_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_9_0"]
#. y1:english="A handmade old type automatic pistol.||There's only one bullet in the chamber."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_9_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_9_0"
msgid "Pistola automática de estilo antiguo hecha a||mano. Sólo tiene una bala en la recámara."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:type=line
#. y1:id=2_10_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0046.BIN
#. y1:english_ids=["2_10_0"]
#. y1:english="A bulletproof shield? It's a compact type.||It becomes handy in this town."
#: MEDIA/TALK/SHOP/TALK_SHOP0046.BIN:2_10_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0046.BIN::line:2_10_0"
msgid "Escudo antibalas. De tipo compacto.||Creo que te será útil en muchas ocasiones."
msgstr ""
