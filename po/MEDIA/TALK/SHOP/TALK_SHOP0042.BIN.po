msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0042.BIN::line:2_3_0"
msgid "Una bandeja lacada.||Además, también resulta práctica."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0042.BIN
