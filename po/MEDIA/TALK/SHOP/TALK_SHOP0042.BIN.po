msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0042.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0042.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="\"Muramasa\", the \"true\" cursed sword.||It makes weird noises when swung."
#: MEDIA/TALK/SHOP/TALK_SHOP0042.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0042.BIN::line:2_2_0"
msgid "Muramasa, conocida como la espada maldita.||Cuando se blande emite un sonido sospechoso."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0042.BIN
#. y1:type=line
