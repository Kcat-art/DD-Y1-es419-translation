#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_0_0"]
#. y1:english="For when you feel drained. It's effective||in restoring mental and physical energy."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_0_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_0_0"
msgid "Para cuando estás completamente exhausto.||Buena para restaurar energía mental y física."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="When you want to maintain your spirit||for a longer time, this is the one."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_1_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_1_0"
msgid "Si quieres mantener tu espíritu más tiempo,||esto es lo que necesitas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="A tactical baton. It's a striking weapon.||Easy to handle since it folds up compactly."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_2_0"
msgid "Un bastón táctico. Es un arma contundente.||es fácil de manejar porque se puede plegar."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="A military survival knife.||A true combat knife."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_3_0"
msgid "Una navaja militar del ejército.||Un verdadero cuchillo de combate."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="A smoke grenade. It renders the enemy blind||for a while within a certain area."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_4_0"
msgid "Granada de humo. Cuando la lanzas durante un||tiempo ciegas a los enemigos a tu alrededor."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="An electric bomb. Think of it||as the bomb version of a stun gun."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_5_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_5_0"
msgid "Una bomba eléctrica. Imagínatela como una||pistola aturdidora, pero en versión bomba."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_6_0"]
#. y1:english="Demon Cloth. Made of really thick material||with a piece of iron sewn into it."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_6_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_6_0"
msgid "Ropa de Demonio. Fabricada con un material||grueso, le han cosido un trozo de hierro."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="Protective gear to be worn within your||clothes. It'll come in handy in this city."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_7_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_7_0"
msgid "Equipo de protección como ropa interior.||En esta ciudad es mejor llevar algo así."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_8_0"]
#. y1:english="An old type automatic pistol. The original||is pretty ancient. It's not very accurate."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_8_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_8_0"
msgid "Pistola automática de estilo antiguo.||El original es antiguo. No es muy precisa."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:type=line
#. y1:id=2_9_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0035.BIN
#. y1:english_ids=["2_9_0"]
#. y1:english="A shotgun. I brought this for you||because this city is shady as fuck."
#: MEDIA/TALK/SHOP/TALK_SHOP0035.BIN:2_9_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0035.BIN::line:2_9_0"
msgid "Una escopeta. Te la he traído porque en||esta ciudad hay que andar con cuidado."
msgstr ""
