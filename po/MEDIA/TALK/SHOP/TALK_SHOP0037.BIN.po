#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:english_ids=["2_0_0"]
#. y1:english="Staminan, energy for the body and spirit||It's good when you're a bit tired."
#: MEDIA/TALK/SHOP/TALK_SHOP0037.BIN:2_0_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0037.BIN::line:2_0_0"
msgid "Staminan, ienergía para cuerpo y espíritu!||Va bien cuando estás un poco cansado."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:type=line
#. y1:id=2_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="When your mental energy is lagging,||use this to keep your spirit from dropping."
#: MEDIA/TALK/SHOP/TALK_SHOP0037.BIN:2_1_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0037.BIN::line:2_1_0"
msgid "Cuando tu energía mental flaquea, toma un||poco, evitará que tu espíritu disminuya."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="With it's fruity scent, this Italian-made||fragrance is popular among women."
#: MEDIA/TALK/SHOP/TALK_SHOP0037.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0037.BIN::line:2_2_0"
msgid "Esta fragancia italiana es popular entre||las mujeres gracias a su aroma afrutado."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="A caviar skin bag.||It's perfect as a present for women."
#: MEDIA/TALK/SHOP/TALK_SHOP0037.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0037.BIN::line:2_3_0"
msgid "Bolsa de cuero 'Caviar'.||Perfecta para regalársela a las mujeres."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="An Italian-made ladies' watch.||This model is all the rage this year."
#: MEDIA/TALK/SHOP/TALK_SHOP0037.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0037.BIN::line:2_4_0"
msgid "Reloj de mujer fabricado en Italia.||Un objeto de lujo, ideal para regalar."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0037.BIN
