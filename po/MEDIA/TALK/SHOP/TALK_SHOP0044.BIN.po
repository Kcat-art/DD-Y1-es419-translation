#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_0_0"]
#. y1:english="A nail claw. It's approximately 2 feet long.||Don't go doing other things with it, okay?"
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_0_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_0_0"
msgid "Un arrancaclavos. Mide aprox. 60 cm.||Y no lo uses para otras cosas, ¿vale?"
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="A stun gun. A popular self-defence weapon.||It should ONLY be used in self-defence."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_1_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_1_0"
msgid "Pistola aturdidora. Arma muy popular.||ÚNICAMENTE se debe usar para defensa propia."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="A sword that's hot in catalog shopping.||It's a stun gun and a sword stuck together."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_2_0"
msgid "Una espada de éxito en ventas por catálogo.||Es pistola aturdidora y espada en uno."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="A wooden sword made of dense wood.||You'll notice the weight difference."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_3_0"
msgid "Una espada fabricada con madera de alta||densidad. Existen diferencias en el peso."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="It was a kodachi used by Musashi Miyamoto.||It's been remade into a dagger."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_4_0"
msgid "Fue el Kodachi que usó Musashi Miyamoto.||Lo han convertido en daga."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="A short sword called Mifune's Kodachi.||It's a pretty handy item."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_5_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_5_0"
msgid "Una espada corta llamada Kodachi de Mifune.||Es un objeto bastante útil."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_6_0"]
#. y1:english="The renowned cursed sword \"Mugetsu\". There||are two others with \"getsu\" in the name."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_6_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_6_0"
msgid "Famosa espada maldita \"Mugetsu\". Se dice que||hay 2 espadas malditas con el nombre \"getsu\""
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="A sacred sword made from the tree of||heaven. It's an item coveted by dilettantes."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_7_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_7_0"
msgid "Espada sacrílega hecha de árbol del cielo.||Muy deseada por los aficionados al arte."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_8_0"]
#. y1:english="Chivalry Cloth. There are people in the gambling||parlour who wrap these around them."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_8_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_8_0"
msgid "Ropa de Caballería. Salón de apuestas, hay||gente que se envuelven en este tipo de ropas"
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_9_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_9_0"]
#. y1:english="Demon Cloth. Made of really thick material||with a piece of iron sewn into it."
#: MEDIA/TALK/SHOP/TALK_SHOP0044.BIN:2_9_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0044.BIN::line:2_9_0"
msgid "Ropa de Demonio. Fabricada con un material||grueso, le han cosido un trozo de hierro."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:type=line
#. y1:id=2_10_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0044.BIN
#. y1:english_ids=["2_10_0"]
#. y1:english="A plate with writing on it. It's the work||of quite a well-known calligrapher."
