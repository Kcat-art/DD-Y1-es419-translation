#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_11_0"]
#. y1:english="An Imperial Army grenade.||I found them at a certain place."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_11_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_11_0"
msgid "Granada del Ejército Imperial. Las descubrí||en cierto lugar. No sé qué potencia tendrán."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_12_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_12_0"]
#. y1:english="A flash bomb. It's really bright, so anyone||on the receiving end will be knocked out."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_12_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_12_0"
msgid "Bomba cegadora. Es muy brillante, quien||reciba el impacto quedará completamente K.O."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_13_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_13_0"]
#. y1:english="A tear grenade. It obstructs the enemies'||field of vision within a certain area."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_13_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_13_0"
msgid "Granada lacrimógena. Se obstruye la visión||de los enemigos en un radio determinado."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_14_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_14_0"]
#. y1:english="A smoke grenade. It renders the enemy blind||for a while within a certain area."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_14_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_14_0"
msgid "Granada de humo. Cuando la lanzas durante un||tiempo ciegas a los enemigos a tu alrededor."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_15_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_15_0"]
#. y1:english="Fighting Cloth. The material's thick.||It'll stop you from feeling a few punches."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_15_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_15_0"
msgid "Ropa de combate. De tejido más grueso de lo normal.||Si te la pones no notarás ningún ataque débil."
msgstr ""
