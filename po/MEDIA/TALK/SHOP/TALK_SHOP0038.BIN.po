#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_10_0"]
#. y1:english="It's a wooden sword made of high density||wood. It's pretty powerful."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_10_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_10_0"
msgid "Es una espada fabricada con madera de||alta densidad. Es bastante resistente."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_11_0
#. y1:alignment=single_line
