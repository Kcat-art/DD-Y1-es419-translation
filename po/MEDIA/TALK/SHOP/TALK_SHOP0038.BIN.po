#. y1:english="An iron pipe? It's made out of a scrap||material, so it's cheap."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_9_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_9_0"
msgid "¿Una tubería de hierro? Hecho de material de||desecho de bajo precio, así que sale barata."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
