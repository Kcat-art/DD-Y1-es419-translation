#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_0_0"]
#. y1:english="Staminan, energy for the body and spirit||It's good when you're a bit tired."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_0_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_0_0"
msgid "Staminan, ienergía para cuerpo y espíritu!||Va bien cuando estás un poco cansado."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="For when you feel drained. It's effective||in restoring mental and physical energy."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_1_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_1_0"
msgid "Para cuando estás completamente exhausto.||Buena para restaurar energía mental y física."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="When your mental energy is lagging,||use this to keep your spirit from dropping."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_2_0"
msgid "Cuando tu energía mental flaquea, toma un||poco, evitará que tu espíritu disminuya."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="When you want to maintain your spirit||for a longer time, this is the one."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_3_0"
msgid "Si quieres mantener tu espíritu más tiempo,||esto es lo que necesitas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="A gavel. It's a wooden hammer. You can act||like you're on the other side of the law."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_4_0"
msgid "Un martillo. Está hecho de madera. Puedes||actuar como si estuvieras fuera de la ley."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="It's an expensive umbrella. Being||an expensive item, it's pretty durable."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_5_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_5_0"
msgid "Es de una gran calidad. Se usa como arma.||El alto precio garantiza su durabilidad."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_6_0"]
#. y1:english="A doctored lighter? Well, basically it's||a mini flamethrower. A clever item, indeed."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_6_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_6_0"
msgid "¿Un súper encendedor? Básicamente es||un mini lanzallamas. Ingenioso, sin duda."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="A doctored iron. No one would be||suspicious if they saw you with this."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_7_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_7_0"
msgid "Plancha manipulada. Gracias a su aspecto,||nadie sospechará cuando vayas por la calle."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:english_ids=["2_8_0"]
#. y1:english="A doctored portable stove. When you hit||someone with this, they catch fire."
#: MEDIA/TALK/SHOP/TALK_SHOP0038.BIN:2_8_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0038.BIN::line:2_8_0"
msgid "Horno portátil manipulado. Cuando golpeas a||alguien con él prenderá fuego."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0038.BIN
#. y1:type=line
#. y1:id=2_9_0
#. y1:alignment=single_line
#. y1:status=paired
