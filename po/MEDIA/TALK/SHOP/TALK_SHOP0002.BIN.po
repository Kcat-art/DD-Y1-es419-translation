#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0002.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="When you want to maintain your spirit||for a longer time, this is the one."
#: MEDIA/TALK/SHOP/TALK_SHOP0002.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0002.BIN::line:2_4_0"
msgid "Si quieres mantener tu espíritu más tiempo,||esto es lo que necesitas."
msgstr ""

