#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_0_0"]
#. y1:english="A health drink for mental and physical||energy. Royal is pretty effective."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_0_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_0_0"
msgid "Una bebida saludable para la energía mental||y física. Royal es bastante efectivo."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="When you want to raise your mental energy||to the max, this is it."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_1_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_1_0"
msgid "Si quieres subir al máximo tu energía mental||esto es lo que necesitas."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="Chivalry Cloth. A famous item, huh?||I had a hard time getting my hands on this."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_2_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_2_0"
msgid "Ropa de Caballería. Así que un objeto famoso||Me costó lo suyo hacerme con esto."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="A military survival knife.||A true combat knife."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_3_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_3_0"
msgid "Una navaja militar del ejército.||Un verdadero cuchillo de combate."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="A tactical baton. It's a striking weapon.||Easy to handle since it folds up compactly."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_4_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_4_0"
msgid "Un bastón táctico. Es un arma contundente.||es fácil de manejar porque se puede plegar."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="A special tactical baton? A stun gun and||tactical baton rolled into one."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_5_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_5_0"
msgid "¿Un bastón táctico especial? Combinación||de pistola aturdidora y bastón táctico."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_6_0"]
#. y1:english="A smoke grenade. It renders the enemy blind||for a while within a certain area."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_6_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_6_0"
msgid "Granada de humo. Cuando la lanzas durante un||tiempo ciegas a los enemigos a tu alrededor."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="An electric bomb. Think of it||as the bomb version of a stun gun."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_7_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_7_0"
msgid "Una bomba eléctrica. Imagínatela como una||pistola aturdidora, pero en versión bomba."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_8_0"]
#. y1:english="A flash bomb. It obstructs enemies' field of||vision within a certain area for a long time."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_8_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_8_0"
msgid "Una bomba cegadora. Quien reciba el impacto||quedará completamente K.O."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_9_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_9_0"]
#. y1:english="An Imperial Army grenade. An antique weapon.||Whether or not it'll work is doubtful."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_9_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_9_0"
msgid "Granada del Ejército Imperial. Arma antigua.||No es seguro que funcione correctamente."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_10_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_10_0"]
#. y1:english="A 9mm automatic pistol. It's easy to handle||and the accuracy is also high."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_10_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_10_0"
msgid "Una pistola automática de 9mm.||Es fácil de manejar y muy precisa."
msgstr ""

#. y1:source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:type=line
#. y1:id=2_11_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/SHOP/TALK_SHOP0036.BIN
#. y1:english_ids=["2_11_0"]
#. y1:english="A bulletproof shield? I sell pieces and||armor. It's common sense in this business."
#: MEDIA/TALK/SHOP/TALK_SHOP0036.BIN:2_11_0
msgctxt "MEDIA/TALK/SHOP/TALK_SHOP0036.BIN::line:2_11_0"
msgid "¿Un escudo antibalas? Vendo todo tipo de||cosas. En este negocio, es de sentido común."
msgstr ""
