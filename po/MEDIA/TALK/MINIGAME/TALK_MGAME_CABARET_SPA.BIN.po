msgctxt "MEDIA/TALK/MINIGAME/TALK_MGAME_CABARET_SPA.BIN::line:25_12_9"
msgid "Qué sorprendente.{MS:0}||¿Así que incluso tú puedes enamorarte?"
msgstr ""

