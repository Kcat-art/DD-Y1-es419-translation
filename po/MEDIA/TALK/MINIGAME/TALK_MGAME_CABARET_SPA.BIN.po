msgctxt "MEDIA/TALK/MINIGAME/TALK_MGAME_CABARET_SPA.BIN::line:11_13_12"
msgid "pero creo que tendrías que comer un poco,||aunque sólo fuera porque ella se ha tomado"
msgstr ""

