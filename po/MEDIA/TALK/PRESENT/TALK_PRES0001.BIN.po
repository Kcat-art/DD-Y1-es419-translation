#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_0_0"]
#. y1:english="In winter, this Japanese stew set is the||dish of choice. It's filling and good."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_0_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_0_0"
msgid "En invierno, muy apreciado guiso japonés.||Llena más de lo que parece y es muy sabroso."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_1_0"]
#. y1:english="A salmon rice ball. It's good since it can||be eaten at any time, but one is not enough."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_1_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_1_0"
msgid "Bola de arroz y salmón. Se puede comer en||cualquier momento, pero nunca es suficiente."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_2_0"]
#. y1:english="A standard lunch box.||The volume is just right."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_2_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_2_0"
msgid "Una fiambrera estándar.||La cantidad es exactamente la adecuada."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_3_0"]
#. y1:english="A club sandwich. Not very filling but||good even when it's cold."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_3_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_3_0"
msgid "Un club sandwich. No llena mucho, pero||sabe bien incluso si se toma frío."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_4_0"]
#. y1:english="Special fried noodles. I got them heated up,||but they taste okay cold too."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_4_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_4_0"
msgid "Fideos fritos especiales. Los calenté,||aunque fríos también son sabrosos."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_5_0"]
#. y1:english="A meat bun. A great snack in the winter.||I wouldn't eat it cold though."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_5_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_5_0"
msgid "Un panecillo de carne. Aperitivo delicioso||en invierno;pero yo no me lo comería frío."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_6_0"]
#. y1:english="The hefty special burger.||It's double stacked and really filling."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_6_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_6_0"
msgid "La consistente hamburguesa especial.||Lleva doble relleno y llena mucho."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_7_0"]
#. y1:english="The hamburger, synonymous with fast food.||I prefer eating it hot."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_7_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_7_0"
msgid "La hamburguesa, sinónimo de comida rápida.||Prefiero comerla caliente."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:english_ids=["2_8_0"]
#. y1:english="The fish burger. It's healthier than the meat counterpart.||A once-in-a-while sort of food.."
#: MEDIA/TALK/PRESENT/TALK_PRES0001.BIN:2_8_0
msgctxt "MEDIA/TALK/PRESENT/TALK_PRES0001.BIN::line:2_8_0"
msgid "Hamburguesa de pescado. Más saludable||que la de carne. De vez en cuando está bien."
msgstr ""

#. y1:source=MEDIA/TALK/PRESENT/TALK_PRES0001.BIN
#. y1:type=line
#. y1:id=2_9_0
#. y1:alignment=single_line
#. y1:status=paired
