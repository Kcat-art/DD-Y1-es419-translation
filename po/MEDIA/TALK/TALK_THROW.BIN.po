#: MEDIA/TALK/TALK_THROW.BIN:3_36_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_36_0"
msgid "Una bufanda francesa.||Se supone que es un buen regalo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_37_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_37_0"]
#. y1:english="An advertising flyer.||It has the opening details of some hostess bar."
#: MEDIA/TALK/TALK_THROW.BIN:3_37_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_37_0"
msgid "Un folleto publicitario.||Con información sobre cierto bar de alterne."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_38_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_38_0"]
#. y1:english="Lucky Bracelet. It's a bracelet that's||said to give you luck with women."
#: MEDIA/TALK/TALK_THROW.BIN:3_38_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_38_0"
msgid "Lo llaman Brazalete Fortuna.||Se dice que te da suerte con las mujeres."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_39_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_39_0"]
#. y1:english="A 10g gold piece.||Selling it would bring in a bit of money."
#: MEDIA/TALK/TALK_THROW.BIN:3_39_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_39_0"
msgid "Una moneda de oro de 10g.||Si la vendes, obtendrás algo de dinero."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_40_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_40_0"]
#. y1:english="A 100g gold piece. Selling it would bring in||a moderate amount of money."
#: MEDIA/TALK/TALK_THROW.BIN:3_40_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_40_0"
msgid "Si la vendes esta moneda||obtendrás cierta cantidad de dinero."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_41_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_41_0"]
#. y1:english="A 1000g gold piece.||Selling it would bring in a fair amount of money."
#: MEDIA/TALK/TALK_THROW.BIN:3_41_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_41_0"
msgid "Una moneda de oro de 1.000g.||Si la vendes, obtendrás bastante dinero."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_42_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_42_0"]
#. y1:english="Matches. A rare item nowadays.||I wonder if it has a use."
#: MEDIA/TALK/TALK_THROW.BIN:3_42_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_42_0"
msgid "Cerillas. Algo raro hoy en día.||Me pregunto si servirá para algo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_43_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_43_0"]
#. y1:english="An assortment of snacks.||I wonder if it has a use."
#: MEDIA/TALK/TALK_THROW.BIN:3_43_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_43_0"
msgid "Un surtido de aperitivos.||Me pregunto si servirá para algo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_44_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_44_0"]
#. y1:english="A bunch of pink lilies.||A pleasing gift for women."
#: MEDIA/TALK/TALK_THROW.BIN:3_44_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_44_0"
msgid "Un ramo de azucenas rosadas.||Un buen regalo para las mujeres."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_45_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_45_0"]
#. y1:english="An assortment of cookies.||A typical gift."
#: MEDIA/TALK/TALK_THROW.BIN:3_45_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_45_0"
msgid "Un surtido de galletas.||Un regalo típico."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_46_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_46_0"]
#. y1:english="Supposedly a high-class Swiss-made watch.||But the workmanship seems a bit shoddy to me."
#: MEDIA/TALK/TALK_THROW.BIN:3_46_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_46_0"
msgid "Se supone que es un reloj de alta calidad,||pero los acabados me parecen medio malos."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_47_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_47_0"]
#. y1:english="A large carpenter's hammer.||The damage upon impact is pretty severe."
#: MEDIA/TALK/TALK_THROW.BIN:3_47_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_47_0"
msgid "Martillo de carpintero grande.||Cuando golpea hace bastante daño."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_48_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_48_0"]
#. y1:english="A beer bottle. Powerful as it is but||also powerful when broken, so a handy item to have."
#: MEDIA/TALK/TALK_THROW.BIN:3_48_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_48_0"
msgid "En su estado actual hace daño,||pero hace más daño si está rota. Será útil."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_49_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_49_0"]
#. y1:english="Rope. Depending on the use,||it could be a powerful weapon."
#: MEDIA/TALK/TALK_THROW.BIN:3_49_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_49_0"
msgid "Cuerda. Según cómo se usara,||podría ser un arma poderosa."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_50_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_50_0"]
#. y1:english="A kettle. Although it can be used as a weapon,||you can't expect it to be particularly effective."
#: MEDIA/TALK/TALK_THROW.BIN:3_50_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_50_0"
msgid "Aunque se puede utilizar como arma,||no puedes esperar mucho de ella."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_51_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_51_0"]
#. y1:english="A crowbar, so-called nail claw.||Extremely effective as a weapon."
#: MEDIA/TALK/TALK_THROW.BIN:3_51_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_51_0"
msgid "El lo que se conoce como un arrancaclavos.||Extremadamente efectiva como arma."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_52_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_52_0"]
#. y1:english="An old Chinese sword. It's a little worn, so you||can't really expect too much durability from it."
#: MEDIA/TALK/TALK_THROW.BIN:3_52_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_52_0"
msgid "Está un poco desgastada,||así que no puedes esperar que te dure mucho."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_53_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_53_0"]
#. y1:english="A bat. If you hit the ball well, you can probably||make it fly a long distance."
#: MEDIA/TALK/TALK_THROW.BIN:3_53_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_53_0"
msgid "Si golpeas bien la bola, seguramente||que podrás hacerla volar muy lejos."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_54_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_54_0"]
#. y1:english="A lamp. If you hit an enemy with this,||they will probably be rendered blind for a while."
#: MEDIA/TALK/TALK_THROW.BIN:3_54_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_54_0"
msgid "Si golpeas a un enemigo con esto,||seguramente quedará cegado por un tiempo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_55_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_55_0"]
#. y1:english="A golf club... I think I'll try to||improve my swing with this thing."
#: MEDIA/TALK/TALK_THROW.BIN:3_55_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_55_0"
msgid "Un palo de golf. Creo que lo utilizaré||para intentar mejorar mi swing."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_56_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_56_0"]
#. y1:english="A thermos. Well, it's better than using bare hands||is all you can say about a weapon like this."
#: MEDIA/TALK/TALK_THROW.BIN:3_56_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_56_0"
msgid "Bueno, es mejor que luchar con los puños.||Es lo que se puede decir de un arma así."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_57_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_57_0"]
#. y1:english="A Chinese butcher knife. The knife itself is pretty||heavy, so it's best for chopping."
#: MEDIA/TALK/TALK_THROW.BIN:3_57_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_57_0"
msgid "El cuchillo pesa bastante, así que||lo mejor es usarlo para cortar en pedacitos."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_58_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_58_0"]
#. y1:english="It's a captain's bat. Some captain regularly used||this sturdy bat."
#: MEDIA/TALK/TALK_THROW.BIN:3_58_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_58_0"
msgid "Hubo un capitán que usó regularmente||este robusto bate."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_59_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_59_0"]
#. y1:english="A lightning bomb. Throwing it can cause the enemy||to become paralyzed."
#: MEDIA/TALK/TALK_THROW.BIN:3_59_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_59_0"
msgid "Una bomba incendiaria. Al lanzarla,||puede paralizar al enemigo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_60_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_60_0"]
#. y1:english="A briefcase. It's robust, making||it useful as a weapon."
#: MEDIA/TALK/TALK_THROW.BIN:3_60_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_60_0"
msgid "Un maletín. Es robusto, lo cual hace||que sea útil como arma."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_61_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_61_0"]
#. y1:english="Mugetsu. The god of darkness lives within||it. It has a cloudy gleam to it."
#: MEDIA/TALK/TALK_THROW.BIN:3_61_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_61_0"
msgid "El dios de la oscuridad habita en esta||espada. Siempre estará turbia."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_62_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_62_0"]
#. y1:english="Sengetsu. The god of thunder lives within||it. It has a dull gleam."
#: MEDIA/TALK/TALK_THROW.BIN:3_62_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_62_0"
msgid "Se dice que en esta espada sin brillo||vive el dios del trueno."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_63_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_63_0"]
#. y1:english="Myogetsu. The god of fire lives within it.||It has a suspicious gleam."
#: MEDIA/TALK/TALK_THROW.BIN:3_63_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_63_0"
msgid "Se dice que en esta espada japonesa de||brillo sospechoso vive el dios del fuego."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_64_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_64_0"]
#. y1:english="Demon's Fang Sword. This sword has a||very sharp edge. It shines brightly."
#: MEDIA/TALK/TALK_THROW.BIN:3_64_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_64_0"
msgid "Espada Comillo de Diablo. Sus bordes||están muy afilados. Su brillo es intenso."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_65_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_65_0"]
#. y1:english="A wooden sword. It's made of oak.||When used skillfully, it's extremely powerful."
#: MEDIA/TALK/TALK_THROW.BIN:3_65_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_65_0"
msgid "Una espada de madera de roble.||Si se usa habilmente, es realmete poderosa."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_66_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_66_0"]
#. y1:english="A long dagger. It has a long reach.||It also has powerful striking capabilities."
#: MEDIA/TALK/TALK_THROW.BIN:3_66_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_66_0"
msgid "Su largo alcance da ventaja en la lucha.||Por supuesto, también asesta golpes fuertes."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_67_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_67_0"]
#. y1:english="A military survival knife.||A true combat knife."
#: MEDIA/TALK/TALK_THROW.BIN:3_67_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_67_0"
msgid "Un cuchillo de supervivencia del ejército.||Un verdadero cuchillo de combate."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_68_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_68_0"]
#. y1:english="A stun gun. It can render an enemy powerless||with high voltage electricity."
#: MEDIA/TALK/TALK_THROW.BIN:3_68_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_68_0"
msgid "Se usa mucho como arma de defensa propia.||Electrocuta al enemigo con alto voltaje."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_69_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_69_0"]
#. y1:english="A blackjack. Can inflict blows without||leaving any marks."
#: MEDIA/TALK/TALK_THROW.BIN:3_69_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_69_0"
msgid "Una cachiporra conocida como Blackjack.||Aturde al enemigo y golpea sin dejar marcas."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_70_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_70_0"]
#. y1:english="Tonfa. A globally handy tool for self-defence.||Can inflict heavier blows than bare hands."
#: MEDIA/TALK/TALK_THROW.BIN:3_70_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_70_0"
msgid "Arma muy útil para la defensa propia.||Asesta golpes más fuertes que los puños."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_71_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_71_0"]
#. y1:english="A tactical baton. A striking type weapon.||Easy to handle since it folds up compactly."
#: MEDIA/TALK/TALK_THROW.BIN:3_71_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_71_0"
msgid "Un bastón táctico. Es un arma contundente.||Fácil de manejar ya que se puede plegar."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_72_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_72_0"]
#. y1:english="A typical Chinese sword. It bows quite often||so it's a little difficult to handle."
#: MEDIA/TALK/TALK_THROW.BIN:3_72_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_72_0"
msgid "Espada china. Se dobla bastante a menudo,||por lo cual resulta un poco difícil de usar."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_73_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_73_0"]
#. y1:english="Brass knuckles, a weapon you wear on your||hands. Old school gangsters used these a lot."
#: MEDIA/TALK/TALK_THROW.BIN:3_73_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_73_0"
msgid "Semiguante para dar puñetazos.||Muy usada por la vieja escuela de gangsters."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_74_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_74_0"]
#. y1:english="Although it's not engraved, it has a dull||gleam and a good blade."
#: MEDIA/TALK/TALK_THROW.BIN:3_74_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_74_0"
msgid "Espada japonesa sin grabados, de hoja||perfecta. Parece sedienta de sangre."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_75_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_75_0"]
#. y1:english="A handmade old type automatic pistol.||There's only one bullet in the chamber."
#: MEDIA/TALK/TALK_THROW.BIN:3_75_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_75_0"
msgid "Pistola de estilo antiguo hecha a mano.||Sólo tiene una bala en la recámara."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_76_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_76_0"]
#. y1:english="A stun gun. A popular self-defence weapon.||The battery is almost dead."
#: MEDIA/TALK/TALK_THROW.BIN:3_76_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_76_0"
msgid "Arma de defensa propia muy popular.||Aturde al enemigo, pero le queda poca pila."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_77_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_77_0"]
#. y1:english="The dagger that Motomiya is said to have used.||Who is this Motomiya?"
#: MEDIA/TALK/TALK_THROW.BIN:3_77_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_77_0"
msgid "La daga que según cuentan usó Motomiya.||¿Quién es ese tal Motomiya?"
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_78_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_78_0"]
#. y1:english="A high quality umbrella. Can also be used as||a weapon. It's pretty durable."
#: MEDIA/TALK/TALK_THROW.BIN:3_78_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_78_0"
msgid "Es de una gran calidad. Se usa como arma.||El alto precio garantiza su durabilidad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_79_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_79_0"]
#. y1:english="A gavel. It's a wooden hammer.||It doesn't look very robust."
#: MEDIA/TALK/TALK_THROW.BIN:3_79_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_79_0"
msgid "Un martillo de madera.||No parece muy resistente."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_80_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_80_0"]
#. y1:english="A smoke grenade. When thrown, it can render the||enemy blind for a while within a certain area."
#: MEDIA/TALK/TALK_THROW.BIN:3_80_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_80_0"
msgid "Ciega durante un tiempo a los enemigos que||estén en un radio determinado."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_81_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_81_0"]
#. y1:english="Darts. You can't expect much of a result from||hitting with these. Just try throwing them."
#: MEDIA/TALK/TALK_THROW.BIN:3_81_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_81_0"
msgid "Dardos. No sirven mucho para golpear.||Lo mejor sería lanzarlos."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_82_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_82_0"]
#. y1:english="A saw. As a weapon, it's a little better||than using bare hands."
#: MEDIA/TALK/TALK_THROW.BIN:3_82_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_82_0"
msgid "Una sierra. Como arma, es poco mejor||que los puños."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_83_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_83_0"]
#. y1:english="An old automatic pistol. The original is||ancient. It's not that accurate."
#: MEDIA/TALK/TALK_THROW.BIN:3_83_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_83_0"
msgid "Pistola automática de estilo antiguo.||El original es antiguo y no muy precisa."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_84_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_84_0"]
#. y1:english="A 9mm automatic pistol. Widespread circulation in||the Far East. Easy to handle and very accurate."
#: MEDIA/TALK/TALK_THROW.BIN:3_84_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_84_0"
msgid "Pistola automática 9mm. Usada en Oriente.||Es fácil de manejar y muy precisa."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_85_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_85_0"]
#. y1:english="A doctored lighter. Tinkering with a lighter||has turned it into a mini-flamethrower."
#: MEDIA/TALK/TALK_THROW.BIN:3_85_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_85_0"
msgid "Este encendedor, una vez manipulado,||se convertirá en un pequeño lanzallamas."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_86_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_86_0"]
#. y1:english="Musashi Miyamoto's dagger. It's robust. It's||uncertain whether it's genuine or not."
#: MEDIA/TALK/TALK_THROW.BIN:3_86_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_86_0"
msgid "Esta daga fue usada Musashi Miyamoto.||Y aunque no sea autentica es muy resistente."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_87_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_87_0"]
#. y1:english="Mifune's Kodachi.||A short sword that has a beautiful sheen to it."
#: MEDIA/TALK/TALK_THROW.BIN:3_87_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_87_0"
msgid "El Kodachi de Mifune.||Una espada corta con un bonito brillo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_88_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_88_0"]
#. y1:english="A tear grenade. When thrown, the enemy's field||of vision can be obstructed within a certain area."
#: MEDIA/TALK/TALK_THROW.BIN:3_88_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_88_0"
msgid "Gas lacrimógeno para cegar al enemigo||que estén en un radio determinado."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_89_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_89_0"]
#. y1:english="Mace. Spraying it at an enemy will obstruct||their field of vision for a certain amount of time."
#: MEDIA/TALK/TALK_THROW.BIN:3_89_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_89_0"
msgid "Spray de defensa personal.||Cegará al enemigo por algún tiempo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_90_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_90_0"]
#. y1:english="Bug spray. Spraying it at an enemy will obstruct||their field of vision for a short while."
#: MEDIA/TALK/TALK_THROW.BIN:3_90_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_90_0"
msgid "Spray insecticida. Al tirarlo al enemigo,||reducirá brevemente su campo de visión."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_91_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_91_0"]
#. y1:english="The knife that Majima Aniki used to use.||It cuts like none other."
#: MEDIA/TALK/TALK_THROW.BIN:3_91_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_91_0"
msgid "Cuchillo que se cuentan usó Majima Aniki.||Tal y como es de esperar, corta bien."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_92_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_92_0"]
#. y1:english="Sacred Wooden Sword. Wood from a 100 year||old sacred tree was used to make this sword."
#: MEDIA/TALK/TALK_THROW.BIN:3_92_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_92_0"
msgid "Espada de madera del Árbol del cielo||Fue un sacrilegio usar esa madera."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_93_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_93_0"]
#. y1:english="A mail order cursed sword. Cursed sword...||through mail order...?! What the...?!"
#: MEDIA/TALK/TALK_THROW.BIN:3_93_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_93_0"
msgid "Una espada maldita encargada por correo.||Hoy en día se compra todo por catálogo..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_94_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_94_0"]
#. y1:english="A special tactical baton. When used to||strike, electricity surges into the enemy."
#: MEDIA/TALK/TALK_THROW.BIN:3_94_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_94_0"
msgid "Bastón táctico especial. Al golpear||desacarga una fuerte corriente eléctrica"
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_95_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_95_0"]
#. y1:english="A dagger that Ninjas used to use.||Lightweight and easy to handle."
#: MEDIA/TALK/TALK_THROW.BIN:3_95_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_95_0"
msgid "Una daga que solían utilizar los ninjas.||Ligera y fácil de manejar."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_96_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_96_0"]
#. y1:english="The engraved sword, Tesshusai. With its rich sheen,||this Japanese sword is a work of art."
#: MEDIA/TALK/TALK_THROW.BIN:3_96_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_96_0"
msgid "Espada grabada, Tesshusai. Esta bruñida||espada japonesa es una obra de arte."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_97_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_97_0"]
#. y1:english="The cursed sword, Muramasa. There are many anecdotes||about this legendary Japanese sword."
#: MEDIA/TALK/TALK_THROW.BIN:3_97_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_97_0"
msgid "Espada maldita Muramasa.||Legendaria espada japonesa."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_98_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_98_0"]
#. y1:english="A shotgun. It's a gun that fires a mass of pellets.||It's very powerful at close range."
#: MEDIA/TALK/TALK_THROW.BIN:3_98_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_98_0"
msgid "Escopeta que dispara perdigones.||Es muy potente en las distancias cortas."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_99_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_99_0"]
#. y1:english="A flash bomb. It obstructs the enemies'||field of vision within a certain range."
#: MEDIA/TALK/TALK_THROW.BIN:3_99_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_99_0"
msgid "Bomba cegadora. Reduce la visión del||enemigo durante mucho tiempo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_100_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_100_0"]
#. y1:english="Imperial Army grenade. An antique weapon.||Who knows if it will even explode."
#: MEDIA/TALK/TALK_THROW.BIN:3_100_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_100_0"
msgid "Granada del Ejército Imperial. Un poco||antigua y puedría fallar."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_101_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_101_0"]
#. y1:english="A butterfly knife. Not that powerful, but||good enough for the average thug."
#: MEDIA/TALK/TALK_THROW.BIN:3_101_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_101_0"
msgid "Navaja mariposa. No es muy fuerte,||pero es una buena arma letal."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_102_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_102_0"]
#. y1:english="A 9mm automatic pistol. Widespread in the Far||East. It has a suspicious gleam to it."
#: MEDIA/TALK/TALK_THROW.BIN:3_102_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_102_0"
msgid "Pistola automática 9mm. Muy usada en||Oriente. Tiene un brillo sospechoso."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_103_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_103_0"]
#. y1:english="This is called a Charisma Ring.||It supposedly has the power to draw women to you."
#: MEDIA/TALK/TALK_THROW.BIN:3_103_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_103_0"
msgid "Se llama Anillo del Carisma.||Tiene poder para atraer mujeres hacia ti."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_104_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_104_0"]
#. y1:english="Goddess' Charm. It's supposed to stop the||enemy from surrounding you in battle."
#: MEDIA/TALK/TALK_THROW.BIN:3_104_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_104_0"
msgid "Un Amuleto de la Diosa de los Niños.||Evita que seas rodeado por los enemigos."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_105_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_105_0"]
#. y1:english="Pimp Bracelet. Exactly what the name||says it is, but whether or not it works..."
#: MEDIA/TALK/TALK_THROW.BIN:3_105_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_105_0"
msgid "El brazalete imán de chicas.||Hay algunas dudas de que funcione."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_106_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_106_0"]
#. y1:english="A picture of a famous gangster. If you keep||this on you, you will attract gangsters."
#: MEDIA/TALK/TALK_THROW.BIN:3_106_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_106_0"
msgid "Fotografía de un personaje carismático||en el bajo mundo. Te atrae malas amistades."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_107_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_107_0"]
#. y1:english="As you'd expect of an Italian perfume, it has an||alluring fragrance. It smells pretty good."
#: MEDIA/TALK/TALK_THROW.BIN:3_107_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_107_0"
msgid "Perfume italiano, de fragancia||encantadora. Huele bastante bien."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_108_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_108_0"]
#. y1:english="Champion's Ring.||It supposedly sets the enemy's heart on fire..."
#: MEDIA/TALK/TALK_THROW.BIN:3_108_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_108_0"
msgid "Anillo de Campeón.||Enciende llamas en el corazón del enemigo..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_109_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_109_0"]
#. y1:english="Macho Cologne. Apparently it was||produced by extracting male pheromones."
#: MEDIA/TALK/TALK_THROW.BIN:3_109_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_109_0"
msgid "Colonia 7 Machos.||Fermento de feromonas masculinas."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_110_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_110_0"]
#. y1:english="Angel's Bells. Enemy attacks are somewhat||reduced when equipping these."
#: MEDIA/TALK/TALK_THROW.BIN:3_110_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_110_0"
msgid "Campanas de Ángel. Si te las pones,||los ataques enemigos se reducen."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_111_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_111_0"]
#. y1:english="Pink nail polish.||Looks like it's of some famous brand name."
#: MEDIA/TALK/TALK_THROW.BIN:3_111_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_111_0"
msgid "Laca para uñas rosa.||Parece que es de una marca famosa."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_112_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_112_0"]
#. y1:english="French perfume.||Its delicate fragrance is like that of a flower."
#: MEDIA/TALK/TALK_THROW.BIN:3_112_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_112_0"
msgid "Perfume francés.||Tiene la delicada fragancia de una flor."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_113_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_113_0"]
#. y1:english="A talisman given to me by Haruka. With this,||I can overcome any adversary."
#: MEDIA/TALK/TALK_THROW.BIN:3_113_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_113_0"
msgid "Un talismán que me dio Haruka.||Me da valor ante cualquier adversidad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_114_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_114_0"]
#. y1:english="Candy given to me by Haruka.||It seems to be a not for sale item."
#: MEDIA/TALK/TALK_THROW.BIN:3_114_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_114_0"
msgid "Un caramelo que me dio Haruka.||Parece ser algo que no está en venta."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_115_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_115_0"]
#. y1:english="Chocolate given to me by Haruka.||I've never seen this packaging before."
#: MEDIA/TALK/TALK_THROW.BIN:3_115_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_115_0"
msgid "Chocolate que me dio Haruka.|| Jamás había visto este envoltorio."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_116_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_116_0"]
#. y1:english="777 Talisman. I'm getting the feeling it may||help me get lucky on the slot machines."
#: MEDIA/TALK/TALK_THROW.BIN:3_116_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_116_0"
msgid "Es el Talismán 777. Tengo la corazonada||de que es útil en las máquinas tragamonedas"
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_117_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_117_0"]
#. y1:english="Given to me by Haruka. Recovers HP and||increases spirit to their maximum capacities."
#: MEDIA/TALK/TALK_THROW.BIN:3_117_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_117_0"
msgid "Kit de primeros auxilios de Haruka.||Recobra PV y llena el Espíritu al máximo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_118_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_118_0"]
#. y1:english="A marble with a curious colour tone.||Haruka gave it to me."
#: MEDIA/TALK/TALK_THROW.BIN:3_118_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_118_0"
msgid "Un mármol de un tono curioso.||Me lo dio Haruka."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_119_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_119_0"]
#. y1:english="A necklace that Haruka gave me. Wearing it makes me||feel like I'm able to stand up to anything.."
#: MEDIA/TALK/TALK_THROW.BIN:3_119_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_119_0"
msgid "Collar que me dio Haruka. Tenerlo me da||valor para enfrentar la adversidad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_120_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_120_0"]
#. y1:english="It's called BANKER Piece.||I wonder what effect it has..."
#: MEDIA/TALK/TALK_THROW.BIN:3_120_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_120_0"
msgid "Es la ficha de la BANCA.||Me pregunto qué efecto tiene..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_121_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_121_0"]
#. y1:english="It's called PLAYER Piece.||I wonder what effect it has..."
#: MEDIA/TALK/TALK_THROW.BIN:3_121_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_121_0"
msgid "Es la ficha del JUGADOR.||Me pregunto qué efecto tiene..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_122_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_122_0"]
#. y1:english="It's a red gem.||I wonder what effect it has..."
#: MEDIA/TALK/TALK_THROW.BIN:3_122_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_122_0"
msgid "Es una gema roja.||Me pregunto qué efecto tiene..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_123_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_123_0"]
#. y1:english="It's a black gem.||I wonder what effect it has..."
#: MEDIA/TALK/TALK_THROW.BIN:3_123_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_123_0"
msgid "Es una gema negra.||Me pregunto qué efecto tiene..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_124_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_124_0"]
#. y1:english="It's called Blackjack Amulet.||I wonder what effect it has..."
#: MEDIA/TALK/TALK_THROW.BIN:3_124_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_124_0"
msgid "Se llama Amuleto del Blackjack.||Me pregunto qué efecto tiene..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_125_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_125_0"]
#. y1:english="Ogre Knuckles. Extremely hard.||Made from a secret mix of metals."
#: MEDIA/TALK/TALK_THROW.BIN:3_125_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_125_0"
msgid "Nudillos metálicos de Ogro.||Muy duros, hechos con una aleación secreta."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_126_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_126_0"]
#. y1:english="Dragon Knuckles. When you put them on,||power surges through your veins."
#: MEDIA/TALK/TALK_THROW.BIN:3_126_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_126_0"
msgid "Nudillos metálicos de Dragón.||Al usarlos el poder corre por tus venas."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=3_127_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["3_127_0"]
#. y1:english="A cedar log used in construction. It looks||like it could break at any moment."
#: MEDIA/TALK/TALK_THROW.BIN:3_127_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:3_127_0"
msgid "Tronco de cedro utilizado en construcción.||Poco fiable, ya que se rompe con facilidad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_0_0"]
#. y1:english="A bottle of Japanese Sake. Even after it's||broken, it has high striking capabilities."
#: MEDIA/TALK/TALK_THROW.BIN:4_0_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_0_0"
msgid "Botella de sake japonés. Llena o rota,||da golpes fuertes. Es útil en un combate."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_1_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_1_0"]
#. y1:english="An iron pipe. Durable up to a point and||has moderate attacking power, so it's useful."
#: MEDIA/TALK/TALK_THROW.BIN:4_1_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_1_0"
msgid "Tubería de hierro. Relativamente duradera||y con cierta potencia ofensiva. De utilidad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_2_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_2_0"]
#. y1:english="A doctored iron. Inflicts more severe damage||than a mere burn."
#: MEDIA/TALK/TALK_THROW.BIN:4_2_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_2_0"
msgid "Plancha manipulada que causa quemaduras||y deja cicatrices nirreversibles."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_3_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_3_0"]
#. y1:english="A doctored portable stove. When you hit||someone with this, they catch fire."
#: MEDIA/TALK/TALK_THROW.BIN:4_3_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_3_0"
msgid "Horno portátil manipulado. Cuando golpeas||a alguien con él, le prende fuego."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_4_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_4_0"]
#. y1:english="A softball. Very easy to throw. You can't||really expect it to be that effective."
#: MEDIA/TALK/TALK_THROW.BIN:4_4_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_4_0"
msgid "Pelota de béisbol. Es muy fácil de lanzar.||No obstante, tiene una baja efectividad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_5_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_5_0"]
#. y1:english="A kettle. Can be used as a weapon for now,||but you can't expect it to be effective."
#: MEDIA/TALK/TALK_THROW.BIN:4_5_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_5_0"
msgid "Tetera. Arma temporal.||No puedes esperar que sea muy efectiva."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_6_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_6_0"]
#. y1:english="A men's umbrella. Somewhat surprisingly,||it can be used as a weapon."
#: MEDIA/TALK/TALK_THROW.BIN:4_6_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_6_0"
msgid "Un paraguas de hombre. Resulta un poco||sorprendente, pero se puede usar como arma."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_7_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_7_0"]
#. y1:english="A fork. It can be used as a weapon||for the time being."
#: MEDIA/TALK/TALK_THROW.BIN:4_7_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_7_0"
msgid "Un tenedor.||Lo puedes utilizar como arma de momento."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_8_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_8_0"]
#. y1:english="A military survival knife. It's kind of an old model||but is totally fine for use in battle."
#: MEDIA/TALK/TALK_THROW.BIN:4_8_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_8_0"
msgid "Navaja de supervivencia del ejército.||Modelo viejo pero excelente para el combate."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_9_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_9_0"]
#. y1:english="An old dagger. The dagger itself is old but||has a really sharp blade."
#: MEDIA/TALK/TALK_THROW.BIN:4_9_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_9_0"
msgid "Daga vieja, pero su hoja está muy afilada.||Te sentirás más seguro si la llevas contigo."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_10_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_10_0"]
#. y1:english="A Chinese sword. A typical Chinese sword.||The workmanship seems a bit shoddy."
#: MEDIA/TALK/TALK_THROW.BIN:4_10_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_10_0"
msgid "Una espada china. Una típica espada china.||La factura no es de muy buena calidad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_11_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_11_0"]
#. y1:english="A Chinese Kunai. It's a throwing knife.||Disposable, so it has almost no durability."
#: MEDIA/TALK/TALK_THROW.BIN:4_11_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_11_0"
msgid "Un Kunai chino. Cuchillo arrojadizo.||Practicamente es desechable."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_12_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_12_0"]
#. y1:english="Lau family's Chinese sword. Supposedly||a great sword with a sharp edge."
#: MEDIA/TALK/TALK_THROW.BIN:4_12_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_12_0"
msgid "Espada china de la familia Lau.||Tiene una hoja muy afilada."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_13_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_13_0"]
#. y1:english="An ashtray. While it's at least a hard object,||to fight with this may be considered foolish."
#: MEDIA/TALK/TALK_THROW.BIN:4_13_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_13_0"
msgid "Un cenicero. Aunque es un objeto duro,||luchar con esto se puede tildar de estúpido."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_14_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_14_0"]
#. y1:english="Table salt. Zero striking power, but handy||for rendering someone temporarily blind."
#: MEDIA/TALK/TALK_THROW.BIN:4_14_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_14_0"
msgid "Sal de mesa. Parece inofensiva, pero||podría dejar temporalmente ciego a alguien."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_15_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_15_0"]
#. y1:english="Pliers. Can be used as a weapon||but probably not that effective."
#: MEDIA/TALK/TALK_THROW.BIN:4_15_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_15_0"
msgid "Alicates. Usados como arma quizá||no sean muy efectivos para causar daño."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_16_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_16_0"]
#. y1:english="An Iai-do sword. A sword used for fast||drawing techniques. It's powerful."
#: MEDIA/TALK/TALK_THROW.BIN:4_16_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_16_0"
msgid "Espada Iai-do. Para desenvainado rápido.||No es una espada célebre, pero es letal."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_17_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_17_0"]
#. y1:english="A forbidden wood sword. Made of hard wood.||It has more power than most wooden swords."
#: MEDIA/TALK/TALK_THROW.BIN:4_17_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_17_0"
msgid "Espada de madera prohibida. Muy dura|| y mas potente que otras espadas de madera."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_18_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_18_0"]
#. y1:english="The Bungo Shimizu Sword. Quite a good sword.||It has a razor sharp edge."
#: MEDIA/TALK/TALK_THROW.BIN:4_18_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_18_0"
msgid "La espada Bungo Shimizu. Una espada||bastante buena. Tiene la hoja afiladísima."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_19_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_19_0"]
#. y1:english="Strawberry shortcake."
#: MEDIA/TALK/TALK_THROW.BIN:4_19_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_19_0"
msgid "Tartaleta de fresas."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_20_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_20_0"]
#. y1:english="An expensive looking plate made of gold.||Its value as an antique is appreciable as well."
#: MEDIA/TALK/TALK_THROW.BIN:4_20_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_20_0"
msgid "Una bandeja de oro de aspecto caro.||También tiene valor como antigüedad."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_21_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_21_0"]
#. y1:english="A plate made of tortoiseshell. Its elegance as||a piece of art is appreciable as well."
#: MEDIA/TALK/TALK_THROW.BIN:4_21_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_21_0"
msgid "Una bandeja de nácar. También se puede||apreciar su elegancia como obra de arte."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_22_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_22_0"]
#. y1:english="A plate made of silver.||It has a magnificent and beautiful sheen."
#: MEDIA/TALK/TALK_THROW.BIN:4_22_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_22_0"
msgid "Una bandeja de plata.||Tiene un brillo bonito y elegante."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_23_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_23_0"]
#. y1:english="A plate made of marble.||Probably nice as an ornament."
#: MEDIA/TALK/TALK_THROW.BIN:4_23_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_23_0"
msgid "Una bandeja de mármol.||Seguramente es bonita como adorno."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_24_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_24_0"]
#. y1:english="A plate with DRAGON written on it. It's the||work of a famous calligrapher."
#: MEDIA/TALK/TALK_THROW.BIN:4_24_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_24_0"
msgid "Bandeja con la inscripción del DRAGÓN.||Obra de un famoso calígrafo. Muy valiosa."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_25_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_25_0"]
#. y1:english="A lacquered plate. It's reasonably valuable,||but probably good as a practical item too."
#: MEDIA/TALK/TALK_THROW.BIN:4_25_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_25_0"
msgid "Una bandeja lacada. Es bastante valiosa,||pero además también resulta práctica."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_26_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_26_0"]
#. y1:english="A golden lighter.||However, it has a cheap sheen to it..."
#: MEDIA/TALK/TALK_THROW.BIN:4_26_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_26_0"
msgid "Un encendedor dorado,||pero con pinta de barato..."
msgstr ""

#. y1:source=MEDIA/TALK/TALK_THROW.BIN
#. y1:type=line
#. y1:id=4_27_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/TALK_THROW.BIN
#. y1:english_ids=["4_27_0"]
#. y1:english="A bat. If you hit the ball well, you can probably||make it fly a long distance."
#: MEDIA/TALK/TALK_THROW.BIN:4_27_0
msgctxt "MEDIA/TALK/TALK_THROW.BIN::line:4_27_0"
msgid "Un bate. Si golpeas bien la bola,|| seguramente podrás hacerla volar muy lejos."
msgstr ""
