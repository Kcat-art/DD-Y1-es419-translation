#: MEDIA/TALK/PAUSE/TALK_PAUSEMISSION.BIN:12_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEMISSION.BIN::line:12_0_0"
msgid "No puedo dejar que me vean los polis.||Tengo que escabullirme y llegar a Serena."
msgstr ""

