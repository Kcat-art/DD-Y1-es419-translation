#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=6_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["6_0_0"]
#. y1:english="Damn, Majima Oyabun becomes a||different person with a knife! Don't||stand still, or he'll stab you to death."
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:6_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:6_0_0"
msgid "Majima se transforma cuando tiene||un cuchillo. Si te congelas o||agachas caerás víctima de él."
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=7_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["7_0_0"]
#. y1:english="But you know what? When Oyabun snaps,||he tends to come straight at you. I||easily evaded him by jumping to the side."
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:7_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:7_0_0"
msgid "Si te golpea, levántate rápido||o te||pisará. Yo pude evadir"
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=8_0_0
#. y1:alignment=unpaired
#. y1:status=missing_en
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=[]
#. y1:english=""
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:8_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:8_0_0"
msgid "a Majima dando un salto lateral."
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=9_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["8_0_0"]
#. y1:english="I figured something out after a stakeout.||Shimano never tries to avoid attacks.||He'll take the hits and tough it out."
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:9_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:9_0_0"
msgid "...Pensaré luego en algo.||Shimano no evita los ataques.||No le dispararé, iré directo"
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=10_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["9_0_0"]
#. y1:english="I'm gonna go head on and beat him with||a weapon. I'm gonna be famous as the||only man to beat him without a gun."
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:10_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:10_0_0"
msgid "hacia él y lo golpearé.||Seré famoso por ser el único en||golpearlo sin una pistola."
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=11_0_0
#. y1:alignment=unpaired
#. y1:status=missing_en
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=[]
#. y1:english=""
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:11_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:11_0_0"
msgid "Este día está cercano."
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=12_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["10_0_0"]
#. y1:english="Last advice to you as Sensei. You tend||to launch daring attacks. An enemy can||easily counterattack by seeing through"
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:12_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:12_0_0"
msgid "Es el último consejo como tu Sensei.||Eres agresivo y das ataques audaces.||Cuando tus enemigos lo sepan,"
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=13_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["11_0_0"]
#. y1:english="it. Also you use your certain skills too||often. If an enemy reads your habits and||invokes those moves, you'll be defeated."
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:13_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:13_0_0"
msgid "sabrán cómo contraatacar.||Te sobreestimas. Si tu enemigo||lee tus hábitos te vencerá."
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=14_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["12_0_0"]
#. y1:english="\"Shinl\" expands your HEAT gauge, making||it last longer to deplete. \"Gi\"||adds techniques and lets you get out of"
#: MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN:14_0_0
msgctxt "MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN::line:14_0_0"
msgid "El libro cubre lo siguiente.||\"Shin\" La Barra FURIA se expande.||\"Gi\" Agrega técnicas y acorta"
msgstr ""

#. y1:source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:type=line
#. y1:id=15_0_0
#. y1:alignment=single_line
#. y1:status=paired
#. y1:english_source=MEDIA/TALK/PAUSE/TALK_PAUSEITEM.BIN
#. y1:english_ids=["13_0_0"]
